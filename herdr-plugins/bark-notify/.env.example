# Copy to .env and adjust. .env is gitignored; this template is committed.
#
# BARK_KEY stays in ~/.env with the rest of this machine's secrets. Put it here
# instead only if you want this plugin to be self-contained.

BARK_QUIET_TZ=Asia/Shanghai
BARK_QUIET_DAYS=mon-fri
BARK_QUIET_HOURS=09:00-12:00,14:00-18:00
# BARK_QUIET_EXEMPT=blocked

BARK_LEVEL=timeSensitive
# BARK_SERVER=https://api.day.app
# BARK_GROUP=herdr
# BARK_SOUND=alarm
# BARK_BLOCKED_DELAY=3
