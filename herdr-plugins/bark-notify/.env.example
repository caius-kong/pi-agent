# Copy to .env. .env is gitignored and mode 600; this template is committed.
# This file is the ONLY config location the plugin reads — there is no fallback
# to ~/.env, so the key is never stored twice.

BARK_KEY=your-device-key

# Silence pushes while you are at the desk.
BARK_QUIET_ENABLE=true
BARK_QUIET_TZ=Asia/Shanghai
BARK_QUIET_DAYS=mon-fri
BARK_QUIET_HOURS=09:00-12:00,14:00-18:00
# BARK_QUIET_EXEMPT=blocked

BARK_LEVEL=timeSensitive
# BARK_SERVER=https://api.day.app
# BARK_GROUP=herdr
# BARK_SOUND=alarm
# BARK_BLOCKED_DELAY=3

# Push body: set_goal, else the last assistant reply, else the terminal title.
# 0 disables that source.
BARK_REPLY_CHARS=200
BARK_GOAL_CHARS=120
