#!/usr/bin/env node
/**
 * Scripted stand-in for `pi --mode rpc`, used ONLY by
 * tests/agent-goal-acceptance-script.test.mjs.
 *
 * It replays what a real run produces — RPC records, session JSONL entries and
 * provider payloads — so the acceptance script's reading and classification can
 * be driven without a model call. The entry order is the real one: the
 * extension's `input` handler persists the carried-over summary BEFORE core
 * appends the user message, and `set_goal` persists again after the call.
 *
 * The scripted model declares material changes and leaves stable goals alone.
 */

const fs = require("node:fs");
const path = require("node:path");

const argv = process.argv.slice(2);
const argOf = (name) => {
  const index = argv.indexOf(name);
  return index !== -1 ? argv[index + 1] : undefined;
};
const SESS_DIR = argOf("--session-dir") || process.cwd();
const SID = argOf("--session-id") || "scripted";
const PAYLOAD_LOG = process.env.AG_EVAL_PAYLOAD_LOG;
const MODE = process.env.FAKE_PI_MODE || "normal";
const SESSION_FILE = path.join(SESS_DIR, `scripted_${SID}.jsonl`);

fs.mkdirSync(SESS_DIR, { recursive: true });

const TASK1 = "Write numbers.txt and stats.mjs, sum now, max and median after approval";
const TASK1_JSON = `${TASK1}, and write stats.json`;
const TASK2 = "write the README.md draft, run example after approval";
const SEP = process.env.FAKE_PI_SEPARATOR || "; ";
const DECLARATIONS = [
  { match: "创建 numbers.txt", summary: TASK1 },
  { match: "写进 stats.json", summary: TASK1_JSON },
  { match: "写 README.md", summary: `${TASK1_JSON}${SEP}${TASK2}` },
];

const state = { goal: null };
let off = false;
let workWritten = false;
let turnIndex = 0;

const append = (entry) => fs.appendFileSync(SESSION_FILE, `${JSON.stringify(entry)}\n`);
const emit = (record) => process.stdout.write(`${JSON.stringify(record)}\n`);
const stateEntry = () => append({
  type: "custom",
  customType: "agent-goal-state",
  data: { goal: state.goal, lastPrompt: null, lastPromptAt: null },
});
const paint = (text) => {
  const lines = [`user_prompt: ${text}`];
  if (state.goal) lines.push(`agent_goal: ${state.goal}`);
  emit({ type: "extension_ui_request", method: "setWidget", widgetKey: "agent-goal", widgetLines: lines });
};

function declarationFor(text) {
  if (MODE === "no-declaration") return null;
  const hit = DECLARATIONS.find((entry) => text.includes(entry.match));
  return hit ? hit.summary : null;
}

function writeWork() {
  if (workWritten) return;
  workWritten = true;
  fs.writeFileSync("loaded-extensions.json", JSON.stringify(argv.flatMap((arg, i) => arg === "-e" ? [argv[i + 1]] : [])));
  fs.writeFileSync("numbers.txt", `${Array.from({ length: 20 }, (_, i) => i + 1).join("\n")}\n`);
  fs.writeFileSync("stats.mjs", "console.log('sum', 'count');\n");
  fs.writeFileSync("README.md", "# work directory\n");
}

function writePayload() {
  if (!PAYLOAD_LOG) return;
  const declared = !off;
  const payload = {
    model: "deepseek-v4.1-flash",
    thinking: { type: "enabled" },
    reasoning_effort: "high",
    tools: declared ? [{ type: "function", function: { name: "set_goal" } }] : [],
    messages: [{ role: "developer", content: declared ? "- set_goal: show the user's still-open session goals" : "- no goal tool here" }],
  };
  fs.appendFileSync(PAYLOAD_LOG, `${JSON.stringify({ payload })}\n`);
}

function declare(goal) {
  append({ type: "message", message: { role: "assistant", content: [{ type: "toolCall", id: `goal-${turnIndex}`, name: "set_goal", arguments: { goal } }] } });
  state.goal = goal || null;
  stateEntry();
}

function handlePrompt(command) {
  const text = command.message || "";
  if (MODE === "exit-mid-run" && text.includes("写进 stats.json")) process.exit(1);
  if (text.startsWith("/agent-goal off")) {
    off = true;
    // Cleared widget: the record carries no widgetLines at all.
    emit({ type: "extension_ui_request", method: "setWidget", widgetKey: "agent-goal" });
    return;
  }

  const firstTurn = turnIndex === 0;
  turnIndex++;
  // OFF: the extension's input handler does not persist while disabled.
  if (!off) stateEntry();
  append({ type: "message", message: { role: "user", content: [{ type: "text", text }] } });
  writeWork();

  const summary = off ? null : declarationFor(text);
  if (MODE === "provider-error" && firstTurn) {
    append({ type: "message", message: { role: "assistant", content: [], stopReason: "error", errorMessage: "rate limited" } });
  } else if (summary !== null) {
    declare(summary);
  } else if (!off && text.includes("读取 next.txt")) {
    append({ type: "message", message: { role: "assistant", content: [{ type: "toolCall", id: "read-next", name: "read", arguments: { path: "next.txt" } }] } });
    append({ type: "message", message: { role: "toolResult", toolCallId: "read-next", toolName: "read", content: [{ type: "text", text: "Translate the introduction into Japanese." }] } });
    if (MODE !== "stale-discovery" && MODE !== "no-declaration") declare(`${state.goal}; translate the introduction into Japanese after confirmation`);
  } else if (!off && MODE === "redundant" && text.includes("当前有几行")) {
    declare(state.goal);
  } else {
    append({ type: "message", message: { role: "assistant", content: [{ type: "text", text: "done" }] } });
  }

  writePayload();
  if (!off) paint(text);
  if (command.id) emit({ type: "response", id: command.id, success: true, data: { disposition: "completed" } });
  emit({ type: "agent_settled" });
}

let buffer = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (chunk) => {
  buffer += chunk;
  let index;
  while ((index = buffer.indexOf("\n")) !== -1) {
    const line = buffer.slice(0, index).trim();
    buffer = buffer.slice(index + 1);
    if (!line) continue;
    let command;
    try { command = JSON.parse(line); } catch { continue; }
    if (command.type === "prompt") handlePrompt(command);
  }
});
process.stdin.on("end", () => process.exit(0));
